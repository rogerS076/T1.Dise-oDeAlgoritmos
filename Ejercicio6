
print("=== Ejercicio 6 ===")
# Lista de calificaciones
calificaciones = [85, 42, 90, 68, 55, 100, 73, 38, 91, 60]

# Creamos las listas
aprobados = []
reprobados = []

# Recorremos las calificaciones
for calificacion in calificaciones:

    if calificacion >= 70:
        aprobados.append(calificacion)
    else:
        reprobados.append(calificacion)

# Calculamos la suma de los aprobados
suma_aprobados = 0

for calificacion in aprobados:
    suma_aprobados = suma_aprobados + calificacion

# Calculamos el promedio
promedio_aprobados = suma_aprobados / len(aprobados)

# Mostramos los resultados
print("Aprobados:", aprobados)
print("Reprobados:", reprobados)
print("Cantidad de aprobados:", len(aprobados))
print("Cantidad de reprobados:", len(reprobados))
print("Promedio de los aprobados:", promedio_aprobados)